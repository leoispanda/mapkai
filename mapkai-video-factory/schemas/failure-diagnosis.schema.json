{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mapkai://video-factory/failure-diagnosis/v1",
  "type": "object",
  "required": ["schemaVersion", "failureType", "confidence", "evidence", "rootCause", "repairTarget", "repairInstructions", "regenerateSamePayload"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "failureType": {"enum": ["EDITORIAL_GUIDANCE_FAILURE", "KNOWLEDGE_PACK_FAILURE", "VIDEO_PROMPT_FAILURE", "GENERATION_VARIANCE_FAILURE", "FACTUAL_FAILURE", "UNKNOWN"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rootCause": {"type": "string"},
    "repairTarget": {"type": "string"},
    "repairInstructions": {"type": "array", "items": {"type": "string"}},
    "regenerateSamePayload": {"type": "boolean"}
  }
}
